# ----- Server -----
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# ----- PostgreSQL -----
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=24062006
PGDATABASE=dcms

# ----- JWT -----
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# ----- Bcrypt -----
BCRYPT_ROUNDS=12

# ----- Uploads -----
UPLOAD_MAX_MB=10
UPLOAD_DIR=src/uploads

# ----- Default admin (used by seed) -----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_FULLNAME=Dr. Admin

# ----- Print -----
LETTERPAD_PATH=src/uploads/letterpad/letterpad.pdf
PRINT_MARGIN_TOP=180
PRINT_MARGIN_LEFT=60
PRINT_MARGIN_RIGHT=60
PRINT_MARGIN_BOTTOM=120
